{
  "kind": "collectionType",
  "collectionName": "transactions",
  "info": {
    "singularName": "transaction",
    "pluralName": "transactions",
    "displayName": "Transaction"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "type": {
      "type": "enumeration",
      "required": true,
      "default": "SALE",
      "enum": [
        "SALE",
        "DEPARTMENT_SUPPLY",
        "DEPARTMENT_BORROW"
      ]
    },
    "custodian": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "inversedBy": "transactions"
    },
    "orderStatus": {
      "type": "enumeration",
      "required": false,
      "default": "Completed",
      "enum": [
        "Pending",
        "Completed",
        "Voided"
      ]
    },
    "notes": {
      "type": "text"
    },
    "items": {
      "type": "component",
      "component": "inventory.line-item",
      "repeatable": true
    },
    "receiptNumber": {
      "type": "string",
      "unique": true
    },
    "studentIdNumber": {
      "type": "string"
    },
    "studentName": {
      "type": "string"
    },
    "purchaseDate": {
      "type": "datetime"
    },
    "departmentName": {
      "type": "string"
    },
    "borrowerName": {
      "type": "string"
    },
    "returnDate": {
      "type": "datetime"
    },
    "isReturned": {
      "type": "boolean",
      "default": false
    }
  }
}